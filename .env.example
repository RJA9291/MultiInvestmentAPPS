APP_NAME="Investment Intelligence Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

LOG_CHANNEL=single
LOG_LEVEL=info

# Supabase Postgres connection string details — Supabase dashboard ->
# Project Settings -> Database -> Connection string ("URI" tab gives you
# all five values below already split out).
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require

CACHE_STORE=file
QUEUE_CONNECTION=sync

# Generate with: php -r "echo bin2hex(random_bytes(32));"
# Never commit a real value here (SEC-011).
JWT_SECRET=
SESSION_TTL_MINUTES=60

# OpenAI — OpenAiProviderGateway is real code (AIServiceProvider binds it
# automatically once OPENAI_API_KEY is set, falling back to
# NullAiProviderGateway otherwise). STATUS (2026-08-08, PDL-062):
# PROMPT-003/PROMPT-004 are now Active in the Prompt Registry, so setting
# this key DOES turn on real AI Compliance pre-check and Document
# verification calls. This activation is a logged Project Owner exception
# skipping the §18 Evaluation Framework for MVP launch speed — it is not a
# claim that either prompt's output has been evaluated for grounding,
# citation accuracy, or hallucination. See PDL-062 (00_MASTER_PROMPT.md)
# and database/seeders/RegistrySeeder.php's evaluation fields.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
