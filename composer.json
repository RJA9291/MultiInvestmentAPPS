{
    "name": "aios/investment-intelligence-platform",
    "type": "project",
    "description": "AIOS (AI Investment Operating System) / Investment Intelligence Platform — Laravel backend. Package/Laravel version choice per 14_LARAVEL_BLUEPRINT.md §477 (explicitly left open as a Sprint 12 implementation decision).",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "firebase/php-jwt": "^6.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "fakerphp/faker": "^1.23"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
